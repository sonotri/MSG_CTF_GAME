rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 닉네임 계정: 누구나 읽기, 새로 만들기만 가능 (비밀번호 변경/삭제 불가)
    match /accounts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'hash'])
        && request.resource.data.name is string
        && request.resource.data.hash is string;
    }

    // 코스별 최고 기록: 점수가 오를 때만 덮어쓰기 가능
    match /{col}/{id} {
      allow read: if col.matches('scores-.*');
      allow create: if col.matches('scores-.*') && validScore();
      allow update: if col.matches('scores-.*') && validScore()
        && request.resource.data.score > resource.data.score;
    }

    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'color', 'score', 'cleared', 'at'])
        && d.name is string && d.name.size() <= 12
        && d.score is int && d.score >= 0 && d.score < 100000;
    }
  }
}
